# Friday local secrets — copy to .env and fill in. .env is gitignored (0600).
# Real environment variables always win over this file. Never commit .env.

# Nemotron reasoning (NVIDIA Build, nvapi-...). Enables full-brain chat.
FRIDAY_NVIDIA_API_KEY=
# Nemotron model + endpoint (defaults work for most accounts).
# Comma-separated fallback chain: Ultra first, smaller siblings when crowded.
FRIDAY_NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
FRIDAY_NEMOTRON_MODELS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3.5-lightning-30b-a3b
FRIDAY_NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# JEV classifier (TypeSafe AI, jv_live_...). Off unless explicitly enabled.
FRIDAY_JEV_KEY=
FRIDAY_JEV_ENABLED=0

# SerpAPI (web search for research; wired when you add a provider step).
SERPAPI_API_KEY=

# Optional second provider (any OpenAI-compatible endpoint: OpenAI, Gemini compat, OpenRouter, ...).
# Used after the Nemotron chain fails. Add `fallback:<model>` to a FRIDAY_MODELS_* list to place it explicitly.
FRIDAY_FALLBACK_BASE_URL=
FRIDAY_FALLBACK_API_KEY=
FRIDAY_FALLBACK_MODEL=
# Per-role chains, comma-separated `provider:model` (defaults: fast Super for turns, Ultra for reason/plan).
# FRIDAY_MODELS_CHAT=nvidia:nvidia/nemotron-3-super-120b-a12b,nvidia:nvidia/nemotron-3-ultra-550b-a55b
# FRIDAY_MODELS_REASON=nvidia:nvidia/nemotron-3-ultra-550b-a55b
# FRIDAY_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# Agent runtime (DeepSeek Harness). Path to its built CLI: <dsh>/apps/cli/lib/bin.js (or put `dsh` on PATH).
FRIDAY_DSH_BIN=
# FRIDAY_DSH_MODEL=nvidia/nemotron-3-super-120b-a12b
# FRIDAY_DSH_ENABLED=1            # 0 = kill switch
# FRIDAY_DSH_SANDBOX=bwrap        # 'off' disables confinement (do not use outside tests)
# FRIDAY_WORKER_CONCURRENCY=1     # server: 2
# FRIDAY_RESOURCE_PROFILE=laptop  # server: server6g

# Optional voice engines for hardware devices (ESP32) — browser voice needs nothing.
# FRIDAY_WHISPER_BIN=/usr/local/bin/whisper-cli
# FRIDAY_WHISPER_MODEL=/opt/models/ggml-base.en.bin
# FRIDAY_PIPER_BIN=/usr/local/bin/piper
# FRIDAY_PIPER_MODEL=/opt/models/en_US-lessac-medium.onnx
# FRIDAY_PUSH_SUBJECT=mailto:you@example.com
# GITHUB_TOKEN=            # enables the GitHub MCP server for agents (fine-grained PAT recommended)

# Voice (run `node bin/friday.mjs voice setup` once): Whisper listens, Kokoro speaks. Loads on demand, unloads after 5 idle minutes.
# FRIDAY_STT_MODEL=small      # base = ~half the RAM/latency, medium = most accurate (slow on CPU)
# FRIDAY_VOICE_ENGINE=cli     # force the whisper.cpp/Piper fallback instead

# --- Docker deployment (compose.yaml) ---
# FRIDAY_AGENT_SECRET=      # shared secret between core and the agent container (deploy script generates it)
# FRIDAY_DATA=/home/you/friday-data   # host directory for the database, token and voice models
# TZ=Asia/Kolkata
