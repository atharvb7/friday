[Unit]
Description=Friday core (personal AI control plane)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@NODE@ @APP_DIR@/src/server.mjs
WorkingDirectory=@APP_DIR@
Environment=FRIDAY_DATA_DIR=@DATA_DIR@
Environment=FRIDAY_PORT=@PORT@
Restart=on-failure
RestartSec=5
# Whole Friday tree (core + DSH + browser/worker children) shares this cgroup.
# Budget: hard ceiling @MEM_MAX@, throttle at @MEM_HIGH@. Swap is not model memory.
MemoryHigh=@MEM_HIGH@
MemoryMax=@MEM_MAX@
MemorySwapMax=512M
TasksMax=512
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
