{
  "manifest_version": 3,
  "name": "Friday for WhatsApp Web",
  "version": "1.1.1",
  "description": "Lets Friday (your assistant on this laptop) read and reply in the WhatsApp Web tab you already have open, only for chats you start with her.",
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "scripting"
  ]
}
