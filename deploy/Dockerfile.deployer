# Friday deployer: builds/runs ONLY Friday's own apps (label friday.app) and publishes them on the tailnet.
FROM tailscale/tailscale:v1.98.10 AS ts
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends tini && rm -rf /var/lib/apt/lists/*
COPY --from=ts /usr/local/bin/tailscale /usr/local/bin/tailscale
WORKDIR /srv/deployer
COPY deployer ./deployer
EXPOSE 4330
ENTRYPOINT ["tini","--"]
CMD ["node","deployer/server.mjs"]
